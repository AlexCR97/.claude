{
  "source": "github",
  "kind": "remote",
  "prefixes": [
    "github",
    "gh"
  ],
  "coordinates": {
    "owner": "namespace",
    "repository": "product"
  },
  "nouns": {
    "singular": "issue",
    "plural": "issues",
    "reference": "#{id}"
  },
  "url": {
    "patterns": [
      "https?://(?:www\\.)?github\\.com/(?P<owner>[^/]+)/(?P<repository>[^/]+)/issues/(?P<id>[1-9][0-9]*)(?:[/?#]|$)"
    ],
    "canonical": "https://github.com/{owner}/{repository}/issues/{id}",
    "refused": [
      {
        "pattern": "https?://(?:www\\.)?github\\.com/[^/]+/[^/]+/pull/[0-9]+(?:[/?#]|$)",
        "reason": "that is a pull request, not an issue"
      }
    ]
  },
  "id": {
    "pattern": "[1-9][0-9]*",
    "shape": "a positive integer issue number in the configured repository"
  },
  "formats": {
    "comment": "markdown",
    "body": "markdown"
  },
  "capabilities": {
    "fetch": true,
    "new": true,
    "update": true,
    "drift": true,
    "related": false,
    "attachments": false
  }
}