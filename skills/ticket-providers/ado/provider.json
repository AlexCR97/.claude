{
  "source": "ado",
  "kind": "remote",
  "prefixes": ["ado", "azdo"],
  "nouns": {
    "singular": "work item",
    "plural": "work items",
    "reference": "#{id}"
  },
  "url": {
    "patterns": [
      "https?://dev\\.azure\\.com/(?P<organization>[^/]+)/(?P<project>[^/]+)/_workitems/edit/(?P<id>[1-9][0-9]*)(?:[/?#]|$)"
    ]
  },
  "id": {
    "pattern": "[1-9][0-9]*",
    "shape": "a positive integer work item id"
  },
  "formats": {
    "comment": "html",
    "body": "html"
  },
  "capabilities": {
    "fetch": true,
    "new": false,
    "publish": true,
    "drift": true,
    "related": true,
    "attachments": true
  }
}
